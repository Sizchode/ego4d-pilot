.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.env
.env.*

# Data, model weights, features, probe checkpoints, and run products live on
# scratch and must never be committed.
data/
features/
artifacts/
outputs/
checkpoints/
envs/
runs/
logs/
results/
!logs/
logs/*
!logs/.gitkeep
!results/
results/*
!results/.gitkeep
*.pt
*.pth
*.safetensors
*.docx
*.log

# Rendered research exports are generated from the source Markdown/Google Doc.
research/**/*.pdf

# Exact external revisions and file digests remain in local run manifests.
configs/*_pinned.json
